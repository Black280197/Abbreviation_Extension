{
    "manifest_version": 3,
    "name": "AutoFill Extension",
    "version": "1.0",
    "description": "Auto fill abbreviations and user management",
    "permissions": [
      "storage",
      "activeTab",
      "identity"
    ],
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "fast.png",
        "32": "fast.png"
      }
    },
    "icons": {
      "16": "fast.png",
      "32": "fast.png"
    }
  }